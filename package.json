{
  "name": "trading-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diario de trading propio: ingesta las operaciones de Quantower y el contexto de order flow de los indicadores",
  "scripts": {
    "ingest": "tsx src/ingest/run.ts",
    "dev": "tsx watch src/api/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "doctor": "node scripts/doctor.mjs",
    "setup:indicators": "node scripts/setup-indicators.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "lightweight-charts": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
